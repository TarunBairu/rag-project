# ==========================================
# RAG Project Environment Configuration Template
# Copy this file to .env and configure your secrets:
#   cp .env.example .env
# ==========================================

# Application Settings
APP_NAME=RAG-Project
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
DEBUG=True
LOG_LEVEL=INFO

# Database Settings
# Primary: PostgreSQL. If unreachable, the system automatically uses SQLite fallback.
DATABASE_URL=postgresql://rag_user:rag_password@localhost:5432/rag_db
SQLITE_FALLBACK_URL=sqlite:///./data/rag.db

# Vector Store Settings
VECTOR_STORE_DIR=./data/vector_store
VECTOR_COLLECTION_NAME=rag_documents

# Embeddings Configuration
# Options: mock, sentence-transformers, openai, gemini
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LLM Generation Configuration
# Options: mock, gemini, openai, groq
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b

# API Keys (Set the one matching your LLM_PROVIDER)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Ingestion & Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval
TOP_K=4
SIMILARITY_THRESHOLD=0.15

# Middleware & Security
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=["*"]
